# PostgreSQL connection string (required). The server will not start without it.
# Get a free one at https://neon.tech, or point at a local Postgres instance.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Session cookie signing secret (required). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Replit Auth (OpenID Connect) — required by server/replitAuth.ts.
# These only work as-is when deployed on Replit. For local development without
# Replit, set REPLIT_DOMAINS to your local host/port and REPL_ID to any string;
# the OIDC discovery call will still succeed, but the actual Replit login flow
# will not, since there is no Repl behind it.
REPLIT_DOMAINS=localhost:5000
REPL_ID=local-dev
ISSUER_URL=https://replit.com/oidc

# Optional: enables AI-powered contact insights (server/aiInsights.ts).
# Leave unset to use the fallback (non-AI) analytics.
OPENAI_API_KEY=

NODE_ENV=development
